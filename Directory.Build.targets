<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Aruba.CodeStyle' and '$(MSBuildProjectName)' != 'Aruba.CodeStyle.CodeFixes'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/CodeStyle/Aruba.CodeStyle.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/CodeStyle/CodeFixes/Aruba.CodeStyle.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
  </ItemGroup>
</Project>